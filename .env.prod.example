# ============================================================================
# Environment Variables Template for Production Deployment
# Copy this to .env and fill in your values
# DO NOT commit .env to git - it contains secrets!
# ============================================================================

# =========================
# MongoDB Configuration
# =========================
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE

MONGO_APP_USER=housingapp
MONGO_APP_PASSWORD=YOUR_SECURE_APP_PASSWORD_HERE

MONGO_DATABASE=HousingUtilitiesSystemDB

# =========================
# JWT Configuration
# =========================
JWT_SECRET=YOUR_64_CHARACTER_HEX_SECRET_KEY_HERE
JWT_EXPIRATION=86400000

# =========================
# OAuth Google
# =========================
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# =========================
# SendGrid Email
# =========================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourapp.com

# =========================
# Application
# =========================
APP_PORT=8080

# =========================
# Elasticsearch (optional)
# =========================
ELASTICSEARCH_URIS=http://elasticsearch:9200

# =========================
# Redis (optional)
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
